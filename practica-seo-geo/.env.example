# Copia este fichero como .env y rellénalo. El .env no se sube a ningún repositorio ni se enseña en pantalla.

# --- Gratuitas: con estas dos claves funciona toda la práctica ---
SERPAPI_API_KEY=          # serpapi.com -> registrarse -> Dashboard -> Your Private API Key
GEMINI_API_KEY=           # aistudio.google.com -> Get API key

# --- Opcionales ---
JINA_API_KEY=             # jina.ai -> API. Sin clave, Jina Reader funciona igual pero más despacio
DATAFORSEO_LOGIN=         # app.dataforseo.com -> API Access. Solo si en caso.toml se elige dataforseo
DATAFORSEO_PASSWORD=
ANTHROPIC_API_KEY=        # solo si [modelo] proveedor = "anthropic"
