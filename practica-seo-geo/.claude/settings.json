{
  "permissions": {
    "allow": [
      "Bash(python3 *)",
      "Bash(python *)",
      "Bash(.venv/bin/python *)",
      "Bash(.venv/bin/pip install -r requirements.txt)",
      "Bash(pip install -r requirements.txt)",
      "Bash(ls *)",
      "Bash(head *)",
      "Bash(wc *)"
    ],
    "deny": [
      "Read(./.env)",
      "Bash(cat .env*)",
      "Bash(rm -rf *)"
    ]
  }
}
